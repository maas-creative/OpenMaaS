{
  "name": "openmaas-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true},
  "vars": {"APP_ORIGIN": "http://localhost:3000", "API_ORIGIN": "http://localhost:8787"},
  "d1_databases": [{"binding":"DB","database_name":"openmaas","database_id":"replace-with-created-database-id","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"FEEDS","bucket_name":"openmaas-feeds"}],
  "ratelimits":[{"name":"SEARCH_LIMITER","namespace_id":"1001","simple":{"limit":30,"period":60}}],
  "triggers": {"crons":["* * * * *"]}
}
