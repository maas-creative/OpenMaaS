# Application
NODE_ENV=development
PORT=3004

# JWT
JWT_SECRET=openmaas-jwt-secret-2024

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenTripPlanner
OTP_URL=http://localhost:8090/otp/routers/default
OTP_TIMEOUT=30000

# Transit Service
TRANSIT_SERVICE_URL=http://localhost:3003

# External APIs
WEATHER_API_KEY=
TRAFFIC_API_KEY=

# Route Planning Settings
DEFAULT_WALK_SPEED=1.4
DEFAULT_BIKE_SPEED=5.0
MAX_WALK_DISTANCE=2000
MAX_BIKE_DISTANCE=20000
DEFAULT_NUM_ITINERARIES=3

# Logging
LOG_LEVEL=debug