# Application
NODE_ENV=development
PORT=3003

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=openmaas
DATABASE_USER=openmaas
DATABASE_PASSWORD=openmaas-dev
DATABASE_SCHEMA=transit

# JWT
JWT_SECRET=openmaas-jwt-secret-2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Transit Data
GTFS_UPDATE_INTERVAL=3600000 # 1 hour in milliseconds
GTFS_STORAGE_PATH=/tmp/gtfs-data
MAX_GTFS_FILE_SIZE=104857600 # 100MB

# External APIs
OTP_URL=http://localhost:8090/otp/routers/default

# Logging
LOG_LEVEL=debug