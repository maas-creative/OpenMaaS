{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "typeRoots": ["./src/types", "../../node_modules/@types"],
    "baseUrl": "../../",
    "paths": {
      "@openmaas/types": ["libs/types/src"],
      "@openmaas/types/*": ["libs/types/src/*"],
      "@openmaas/common/*": ["libs/common/src/*"],
      "@openmaas/utils/*": ["libs/utils/src/*"]
    }
  },
  "include": ["src/**/*", "../types/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
