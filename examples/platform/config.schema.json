{
  "$ref": "#/definitions/OpenMaaS",
  "definitions": {
    "OpenMaaS": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            1,
            2
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "ja",
            "en"
          ],
          "default": "ja"
        },
        "timezone": {
          "type": "string",
          "default": "Asia/Tokyo"
        },
        "contact": {
          "type": "string"
        },
        "features": {
          "type": "object",
          "properties": {
            "activities": {
              "type": "boolean"
            },
            "transit": {
              "type": "boolean"
            },
            "accommodations": {
              "type": "boolean"
            },
            "commerce": {
              "type": "boolean"
            }
          },
          "required": [
            "activities",
            "transit",
            "accommodations",
            "commerce"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,60}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "luma",
                  "connpass",
                  "rakuten",
                  "gtfs",
                  "gtfs-rt",
                  "gbfs",
                  "odpt",
                  "eventbrite",
                  "ticketmaster",
                  "tomtom",
                  "square",
                  "viator",
                  "booking",
                  "expedia",
                  "uber",
                  "masabi",
                  "google-calendar"
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "secretRef": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "intervalSeconds": {
                "type": "integer",
                "minimum": 60,
                "default": 300
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "termsUrl": {
                "$ref": "#/definitions/OpenMaaS/properties/sources/items/properties/url"
              },
              "region": {
                "type": "string",
                "default": ""
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "staticSourceId": {
                "type": "string"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "quote",
                    "reserve",
                    "lookup",
                    "cancel",
                    "fulfill",
                    "calendar-write"
                  ]
                },
                "default": []
              },
              "manual": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "event",
                        "experience",
                        "facility",
                        "accommodation",
                        "parking",
                        "ride"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "default": ""
                    },
                    "url": {
                      "$ref": "#/definitions/OpenMaaS/properties/sources/items/properties/url"
                    },
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lon": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "receptionStart": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "scheduled",
                        "cancelled"
                      ],
                      "default": "scheduled"
                    },
                    "online": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "category"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "attribution",
              "termsUrl"
            ],
            "additionalProperties": false
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "currency": {
                "type": "string",
                "const": "JPY"
              },
              "validHours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 720
              },
              "enabled": {
                "type": "boolean"
              },
              "terms": {
                "type": "string",
                "minLength": 1
              },
              "seller": {
                "type": "string",
                "minLength": 1
              },
              "contact": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "amount",
              "currency",
              "validHours",
              "enabled",
              "terms",
              "seller",
              "contact"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "journey": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "none",
                "otp",
                "ekispert"
              ]
            },
            "url": {
              "$ref": "#/definitions/OpenMaaS/properties/sources/items/properties/url"
            },
            "secretRef": {
              "type": "string"
            },
            "routerId": {
              "type": "string",
              "default": "default"
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false,
          "default": {
            "provider": "none",
            "routerId": "default"
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "$ref": "#/definitions/OpenMaaS/properties/sources/items/properties/url"
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "clientSecretRef": {
              "type": "string"
            }
          },
          "required": [
            "issuer",
            "clientId"
          ],
          "additionalProperties": false
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "version",
        "name",
        "region",
        "contact",
        "features",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
