# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://openmaas:openmaas-dev@localhost:5432/openmaas

# Redis
REDIS_URL=redis://localhost:6379

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=openmaas
KEYCLOAK_CLIENT_ID=openmaas-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Kong
KONG_ADMIN_URL=http://localhost:8001
KONG_PROXY_URL=http://localhost:8000

# OpenTripPlanner
OTP_URL=http://localhost:8090

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_FILE_SIZE=10MB

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@openmaas.org
SMTP_PASS=your-smtp-password
EMAIL_FROM=OpenMaaS <noreply@openmaas.org>

# Payment Gateway (example - Stripe)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Maps
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_PAYMENT=false
ENABLE_RESERVATIONS=false